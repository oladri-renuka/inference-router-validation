{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Smart Load Balancer Validation\n",
    "\n",
    "End-to-end validation of predicted-cost routing for LLM inference.\n",
    "Addresses limitations:\n",
    "1. Reproducible seed\n",
    "2. Production vLLM config (enforce_eager=false)\n",
    "3. Threshold validation (confusion matrix)\n",
    "4. Improved predictor\n",
    "5. Multi-model testing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import yaml\n",
    "import json\n",
    "import logging\n",
    "from pathlib import Path\n",
    "import sys\n",
    "\n",
    "sys.path.insert(0, 'src')\n",
    "\n",
    "from predictor import OutputLengthPredictor, PromptFeatureExtractor\n",
    "from load_balancer import SmartLoadBalancer, RoutingStrategy\n",
    "\n",
    "logging.basicConfig(level=logging.INFO)\n",
    "logger = logging.getLogger(__name__)\n",
    "\n",
    "print(\"Imports successful\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load configuration\n",
    "with open('config.yaml', 'r') as f:\n",
    "    config = yaml.safe_load(f)\n",
    "\n",
    "# Set random seed for reproducibility\n",
    "np.random.seed(config['seed'])\n",
    "\n",
    "print(f\"Seed: {config['seed']}\")\n",
    "print(f\"Models: {[m['name'] for m in config['models']]}\")\n",
    "print(f\"vLLM config: enforce_eager={config['vllm']['enforce_eager']}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Install vLLM if needed\n",
    "import subprocess\n",
    "try:\n",
    "    from vllm import LLM\n",
    "except ImportError:\n",
    "    print(\"Installing vLLM...\")\n",
    "    subprocess.run(['pip', 'install', 'vllm', 'transformers', 'torch', 'datasets', 'scikit-learn'], check=True)\n",
    "    from vllm import LLM\n",
    "\n",
    "print(\"vLLM available\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load Alpaca dataset\n",
    "from datasets import load_dataset\n",
    "\n",
    "print(f\"Loading Alpaca dataset...\")\n",
    "dataset = load_dataset('tatsu-lab/alpaca', split='train')\n",
    "num_prompts = config['dataset']['num_prompts']\n",
    "prompts = [item['instruction'] for item in dataset[:num_prompts]]\n",
    "\n",
    "print(f\"Loaded {len(prompts)} prompts\")\n",
    "print(f\"Sample prompt: {prompts[0][:100]}...\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Initialize vLLM and collect inference data\n",
    "# This will take 30-60 minutes depending on GPU\n",
    "\n",
    "from vllm import LLM, SamplingParams\n",
    "\n",
    "model_name = config['models'][0]['name']  # Start with first model\n",
    "max_tokens = config['models'][0]['max_tokens']\n",
    "\n",
    "print(f\"Initializing {model_name}...\")\n",
    "llm = LLM(\n",
    "    model=model_name,\n",
    "    gpu_memory_utilization=config['vllm']['gpu_memory_utilization'],\n",
    "    max_model_len=config['vllm']['max_model_len'],\n",
    "    kv_cache_dtype=config['vllm']['kv_cache_dtype'],\n",
    "    cpu_offload_num_gpu_blocks=config['vllm']['cpu_offload_gb'],\n",
    "    enforce_eager=config['vllm']['enforce_eager']\n",
    ")\n",
    "\n",
    "print(\"Model loaded\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Run inference on all prompts\n",
    "print(f\"Running inference on {len(prompts)} prompts...\")\n",
    "\n",
    "sampling_params = SamplingParams(temperature=0.7, max_tokens=max_tokens)\n",
    "outputs = llm.generate(prompts, sampling_params)\n",
    "\n",
    "# Extract output lengths\n",
    "output_lengths = [len(output.outputs[0].token_ids) for output in outputs]\n",
    "\n",
    "print(f\"Inference complete\")\n",
    "print(f\"Output length stats: min={min(output_lengths)}, max={max(output_lengths)}, mean={np.mean(output_lengths):.1f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Train predictor with multiple model types\n",
    "train_idx = np.random.choice(len(prompts), int(len(prompts) * config['predictor']['train_split']), replace=False)\n",
    "test_idx = np.array([i for i in range(len(prompts)) if i not in train_idx])\n",
    "\n",
    "prompts_train = [prompts[i] for i in train_idx]\n",
    "lengths_train = [output_lengths[i] for i in train_idx]\n",
    "prompts_test = [prompts[i] for i in test_idx]\n",
    "lengths_test = [output_lengths[i] for i in test_idx]\n",
    "\n",
    "print(f\"Train: {len(prompts_train)}, Test: {len(prompts_test)}\")\n",
    "\n",
    "# Extract test features\n",
    "extractor = PromptFeatureExtractor()\n",
    "X_test = np.vstack([extractor.extract_features(p).flatten() for p in prompts_test])\n",
    "y_test = np.array(lengths_test)\n",
    "\n",
    "# Train multiple predictor models\n",
    "predictor_results = {}\n",
    "for model_type in ['ridge', 'lasso', 'elasticnet']:\n",
    "    print(f\"\\nTraining {model_type}...\")\n",
    "    predictor = OutputLengthPredictor(alpha=config['predictor']['ridge_alpha'], model_type=model_type)\n",
    "    predictor.train(prompts_train, lengths_train)\n",
    "    \n",
    "    r2 = predictor.score(X_test, y_test)\n",
    "    mae = predictor.mae(X_test, y_test)\n",
    "    \n",
    "    predictor_results[model_type] = {\n",
    "        'r2': float(r2),\n",
    "        'mae': float(mae),\n",
    "        'predictor': predictor\n",
    "    }\n",
    "    \n",
    "    print(f\"{model_type}: R²={r2:.4f}, MAE={mae:.1f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Threshold validation: confusion matrix\n",
    "print(\"\\nThreshold Validation (500 tokens)\\n\")\n",
    "\n",
    "for model_type, result in predictor_results.items():\n",
    "    predictor = result['predictor']\n",
    "    cm = predictor.confusion_matrix_at_threshold(X_test, y_test, threshold=config['smart_routing']['cost_threshold'])\n",
    "    \n",
    "    print(f\"{model_type}:\")\n",
    "    print(f\"  TP={cm['true_positive']}, TN={cm['true_negative']}, FP={cm['false_positive']}, FN={cm['false_negative']}\")\n",
    "    print(f\"  Accuracy={cm['accuracy']:.3f}, Precision={cm['precision']:.3f}, Recall={cm['recall']:.3f}, F1={cm['f1_score']:.3f}\")\n",
    "    \n",
    "    result['confusion_matrix'] = cm"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# A/B Test: Smart routing vs Round-robin\n",
    "# Use best predictor (Ridge by default)\n",
    "best_predictor = predictor_results['ridge']['predictor']\n",
    "\n",
    "print(f\"Running A/B test with {config['a_b_test']['requests_per_strategy']} requests per strategy...\")\n",
    "print(f\"Using {config['a_b_test']['num_workers']} workers\\n\")\n",
    "\n",
    "# Simulate latencies based on output length\n",
    "# Longer outputs = more latency (roughly proportional to tokens)\n",
    "def simulate_latency(output_tokens, worker_load=0.0):\n",
    "    base_latency = 100 + output_tokens * 8  # Base + 8ms per token\n",
    "    load_factor = 1 + worker_load * 0.3\n",
    "    noise = np.random.normal(0, 50)\n",
    "    return max(base_latency * load_factor + noise, 50)\n",
    "\n",
    "# Test samples\n",
    "n_test = config['a_b_test']['requests_per_strategy']\n",
    "test_sample_idx = np.random.choice(len(prompts), n_test, replace=False)\n",
    "test_prompts = [prompts[i] for i in test_sample_idx]\n",
    "test_lengths = [output_lengths[i] for i in test_sample_idx]\n",
    "\n",
    "# Predict lengths\n",
    "predicted_lengths = best_predictor.predict_batch(test_prompts)\n",
    "\n",
    "print(f\"Sample predictions: {predicted_lengths[:5]}\")\n",
    "print(f\"Sample actual: {test_lengths[:5]}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Smart routing A/B test\n",
    "lb_smart = SmartLoadBalancer(num_workers=config['a_b_test']['num_workers'])\n",
    "smart_latencies = []\n",
    "\n",
    "for i, (prompt, actual_length, predicted_length) in enumerate(zip(test_prompts, test_lengths, predicted_lengths)):\n",
    "    worker_id = lb_smart.route_request(i, predicted_length, RoutingStrategy.PREDICTED_COST, config['smart_routing']['cost_threshold'])\n",
    "    latency = simulate_latency(actual_length, lb_smart.metrics[worker_id].load_score)\n",
    "    lb_smart.record_completion(worker_id, latency)\n",
    "    smart_latencies.append(latency)\n",
    "\n",
    "print(f\"Smart routing complete: {len(smart_latencies)} latencies\")\n",
    "print(f\"Mean: {np.mean(smart_latencies):.1f}ms, P95: {np.percentile(smart_latencies, 95):.1f}ms\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Round-robin baseline\n",
    "lb_rr = SmartLoadBalancer(num_workers=config['a_b_test']['num_workers'])\n",
    "rr_latencies = []\n",
    "\n",
    "for i, (prompt, actual_length) in enumerate(zip(test_prompts, test_lengths)):\n",
    "    worker_id = lb_rr.route_request(i, 0, RoutingStrategy.ROUND_ROBIN)\n",
    "    latency = simulate_latency(actual_length, lb_rr.metrics[worker_id].load_score)\n",
    "    lb_rr.record_completion(worker_id, latency)\n",
    "    rr_latencies.append(latency)\n",
n",
    "print(f\"Round-robin complete: {len(rr_latencies)} latencies\")\n",
    "print(f\"Mean: {np.mean(rr_latencies):.1f}ms, P95: {np.percentile(rr_latencies, 95):.1f}ms\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Statistical analysis\n",
    "from scipy import stats\n",
    "\n",
    "smart_arr = np.array(smart_latencies)\n",
    "rr_arr = np.array(rr_latencies)\n",
    "\n",
    "# Mean comparison\n",
    "mean_smart = np.mean(smart_arr)\n",
    "mean_rr = np.mean(rr_arr)\n",
    "std_smart = np.std(smart_arr)\n",
    "std_rr = np.std(rr_arr)\n",
    "\n",
    "# T-test\n",
    "t_stat, p_value = stats.ttest_ind(smart_arr, rr_arr)\n",
    "\n",
    "# Confidence intervals\n",
    "se_smart = std_smart / np.sqrt(len(smart_arr))\n",
    "ci_smart = (mean_smart - 1.96*se_smart, mean_smart + 1.96*se_smart)\n",
    "\n",
    "se_rr = std_rr / np.sqrt(len(rr_arr))\n",
    "ci_rr = (mean_rr - 1.96*se_rr, mean_rr + 1.96*se_rr)\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"A/B TEST RESULTS\")\n",
    "print(\"=\"*60)\n",
    "print(f\"\\nSmart Routing:  n={len(smart_arr)}, mean={mean_smart:.1f}ms, std={std_smart:.1f}ms\")\n",
    "print(f\"  P50={np.percentile(smart_arr, 50):.1f}ms, P95={np.percentile(smart_arr, 95):.1f}ms, P99={np.percentile(smart_arr, 99):.1f}ms\")\n",
    "print(f\"  95% CI: [{ci_smart[0]:.1f}, {ci_smart[1]:.1f}]ms\")\n",
    "print(f\"\\nRound-Robin:    n={len(rr_arr)}, mean={mean_rr:.1f}ms, std={std_rr:.1f}ms\")\n",
    "print(f\"  P50={np.percentile(rr_arr, 50):.1f}ms, P95={np.percentile(rr_arr, 95):.1f}ms, P99={np.percentile(rr_arr, 99):.1f}ms\")\n",
    "print(f\"  95% CI: [{ci_rr[0]:.1f}, {ci_rr[1]:.1f}]ms\")\n",
    "print(f\"\\nImprovement:    {mean_rr - mean_smart:.1f}ms ({(mean_rr - mean_smart)/mean_rr*100:.1f}%)\")\n",
    "print(f\"t-statistic:    {t_stat:.3f}\")\n",
    "print(f\"p-value:        {p_value:.4f} {'(SIGNIFICANT)' if p_value < 0.05 else '(NOT SIGNIFICANT)'}\")\n",
    "print(\"=\"*60)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Save results\n",
    "Path('results').mkdir(exist_ok=True)\n",
    "\n",
    "results = {\n",
    "    'seed': config['seed'],\n",
    "    'model': model_name,\n",
    "    'predictor_accuracy': {\n",
    "        'ridge': predictor_results['ridge'],\n",
    "        'lasso': predictor_results['lasso'],\n",
    "        'elasticnet': predictor_results['elasticnet']\n",
    "    },\n",
    "    'threshold_validation': {\n",
    "        'ridge': predictor_results['ridge'].get('confusion_matrix'),\n",
    "        'lasso': predictor_results['lasso'].get('confusion_matrix'),\n",
    "        'elasticnet': predictor_results['elasticnet'].get('confusion_matrix')\n",
    "    },\n",
    "    'a_b_test': {\n",
    "        'smart_routing': {\n",
    "            'mean': float(mean_smart),\n",
    "            'std': float(std_smart),\n",
    "            'p50': float(np.percentile(smart_arr, 50)),\n",
    "            'p95': float(np.percentile(smart_arr, 95)),\n",
    "            'p99': float(np.percentile(smart_arr, 99)),\n",
    "            'ci_lower': float(ci_smart[0]),\n",
    "            'ci_upper': float(ci_smart[1])\n",
    "        },\n",
    "        'round_robin': {\n",
    "            'mean': float(mean_rr),\n",
    "            'std': float(std_rr),\n",
    "            'p50': float(np.percentile(rr_arr, 50)),\n",
    "            'p95': float(np.percentile(rr_arr, 95)),\n",
    "            'p99': float(np.percentile(rr_arr, 99)),\n",
    "            'ci_lower': float(ci_rr[0]),\n",
    "            'ci_upper': float(ci_rr[1])\n",
    "        },\n",
    "        'comparison': {\n",
    "            'mean_improvement_ms': float(mean_rr - mean_smart),\n",
    "            'mean_improvement_pct': float((mean_rr - mean_smart)/mean_rr*100),\n",
    "            't_statistic': float(t_stat),\n",
    "            'p_value': float(p_value),\n",
    "            'significant': bool(p_value < 0.05)\n",
    "        }\n",
    "    }\n",
    "}\n",
    "\n",
    "with open('results/validation_results.json', 'w') as f:\n",
    "    json.dump(results, f, indent=2)\n",
    "\n",
    "print(\"Results saved to results/validation_results.json\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Next Steps\n",
    "\n",
    "1. Repeat for additional models (Llama-2-7b, Phi-2)\n",
    "2. Compare results across models\n",
    "3. Identify best predictor model (Ridge/Lasso/ElasticNet)\n",
    "4. Test threshold sensitivity (200, 300, 500, 1000 tokens)\n",
    "5. Deploy to real multi-GPU cluster for validation"
   ]
  }
